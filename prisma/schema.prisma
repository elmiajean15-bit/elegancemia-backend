// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id String @id @default(uuid()) @map("id")

  name String @map("name")

  email String  @unique @map("email")
  phone String? @unique @map("phone")

  password String @map("password")

  avatar   String?       @map("avatar")

  role AdminRole @default(admin) @map("role")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

enum AdminRole {
  admin
  super_admin
  manager
}

model Client {
  id       String        @id @default(uuid()) @map("id")
  name     String        @map("name")
  email    String        @unique @map("email")
  phone    String        @map("phone")
  city     String?       @map("city")
  country  String?       @map("country")
  gender   ClientGender? @map("gender")
  avatar   String?       @map("avatar")
  role     ClientRole    @default(client) @map("role")
  isActive Boolean       @default(true) @map("is_active")

  password String @map("password")

  orders           Order[]
  customModeOrders CustomModeOrder[]
  reviews          Review[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("clients")
}

model Product {
 id String @id @default(uuid()) @map("id")
 slug String @unique @map("slug")
 name String @map("name")
 description String @map("description") @db.Text

 category ProductCategory @map("category")
 price Float @map("price")
 currency Currency @map("currency")

 featured Boolean @default(false) @map("featured")
 rating Float? @map("rating")

 stockQuantity Int @default(0) @map("stock_quantity")
 inStock Boolean @default(true) @map("in_stock")

 createdAt DateTime @default(now()) @map("created_at")

 images ProductImage[]
 variants ProductVariant[]
 productTags ProductToProductTag[]
 reviews Review[]
 orderItems OrderItem[]

 @@map("products")
}

model ProductTag {
 id String @id @default(uuid()) @map("id")
 name String @map("name")
 slug String @unique @map("slug")

 productTags ProductToProductTag[]

 @@map("product_tags")
}

model ProductToProductTag {
 productId String @map("product_id")
 tagId String @map("tag_id")

 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 tag ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

 @@id([productId, tagId])
 @@map("product_to_product_tag")
}


model ProductImage {
  id  String  @id @default(uuid()) @map("id")
  url String  @map("url")
  alt String? @map("alt")

  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  @@map("product_images")
}

model ProductVariant {
  id    String @id @default(uuid()) @map("id")
  name  String @map("name")
  value String @map("value")

  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  @@map("product_variants")
}

model Review {
  id String @id @default(uuid()) @map("id")

  name    String @map("name")
  rating  Int    @map("rating")
  comment String @map("comment")

  verified Boolean @default(false) @map("verified")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model PortfolioProject {
  id          String @id @default(uuid()) @map("id")
  slug        String @unique @map("slug")
  title       String @map("title")
  description String @map("description") @db.Text

  category PortfolioCategory @map("category")
  year     Int               @map("year")

  featured Boolean @default(false) @map("featured")

  images PortfolioImage[]

  @@map("portfolio_projects")
}

model PortfolioImage {
  id  String @id @default(uuid()) @map("id")
  url String @map("url")
  alt String @map("alt")

  project   PortfolioProject @relation(fields: [projectId], references: [id])
  projectId String           @map("project_id")

  @@map("portfolio_images")
}

model BlogPost {
  id      String @id @default(uuid()) @map("id")
  slug    String @unique @map("slug")
  title   String @map("title")
  excerpt String @db.Text @map("excerpt")
  content String @db.Text @map("content")

  category BlogCategory @map("category")

  coverUrl String @map("cover_url")
  coverAlt String @map("cover_alt")

  authorName   String @map("author_name")
  authorAvatar String @map("author_avatar")

  featured Boolean @default(false) @map("featured")

  publishedAt DateTime @map("published_at")

  @@map("blog_posts")
}

model Order {
  id String @id @default(uuid()) @map("id")

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  total    Float    @map("total")
  currency Currency @map("currency")

  status String @map("status")

  items    OrderItem[]
  payments Payment[]

  // 🚚 SHIPPING
  shippingMethodId String?         @map("shipping_method_id")
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])

  // 👤 SNAPSHOT CLIENT (IMPORTANT pour guest checkout)
  fullName String  @map("full_name")
  phone    String  @map("phone")
  email    String? @map("email")
  address  String  @map("address")

  // 💳 TRACKING PAIEMENT
  paymentStatus    String? @map("payment_status") // pending, success, failed
  paymentReference String? @map("payment_reference") // ref interne

  createdAt DateTime @default(now()) @map("created_at")

  @@map("orders")
}

model GuestClient {
  id String @id @default(uuid()) @map("id")

  nom       String  @map("nom")
  email     String  @map("email")
  telephone String? @map("telephone")
  ville     String? @map("ville")
  pays      String? @map("pays")
  source    String? @map("source")

  orders CustomModeOrder[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("guest_clients")
}

model OrderItem {
  id String @id @default(uuid()) @map("id")

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @map("order_id")

  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  quantity Int     @map("quantity")
  price    Float   @map("price")
  name     String? @map("name")

  @@map("order_items")
}

model ShippingMethod {
  id String @id @default(uuid()) @map("id")

  name String       @map("name")
  zone ShippingZone @map("zone")
  city String       @map("city")

  price    Float    @map("price")
  currency Currency @map("currency")

  estimatedDays Int     @map("estimated_days")
  active        Boolean @default(true) @map("active")

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("shipping_methods")
}

model Payment {
  id String @id @default(uuid()) @map("id")

  transactionId String? @map("transaction_id")

  method PaymentMethod @map("method")

  amount Float @map("amount")

  // Payment
  amountPaid Float @default(0) @map("amount_paid")

  currency Currency @map("currency")

  status String @map("status")

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id])

  customModeOrderId String?          @map("custom_mode_order_id")
  customModeOrder   CustomModeOrder? @relation(fields: [customModeOrderId], references: [id])

  // 🔗 FedaPay
  fedapayId  String? @map("fedapay_id")
  paymentUrl String? @map("payment_url")

  // 📡 WEBHOOK
  rawResponse Json? @map("raw_response")

  // 🔐 sécurité
  reference String? @map("reference")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("payments")
}

model CustomModeOrder {
  id String @id @default(uuid()) @map("id")

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  guestClientId String?      @map("guest_client_id")
  guestClient   GuestClient? @relation(fields: [guestClientId], references: [id])

  // EXISTANT (inchangé)
  type     String @map("type")
  genre    String @map("genre")
  pieces   String @map("pieces")
  occasion String @map("occasion")

  style       String @map("style")
  couleur     String @map("couleur")
  matiere     String @map("matiere")
  complexite  String @map("complexite")
  inspiration String @map("inspiration")

  taille      String @map("taille")
  morphologie String @map("morphologie")
  finitions   String @map("finitions")
  accessoires String @map("accessoires")
  essayage    String @map("essayage")

  budget    String @map("budget")
  delai     String @map("delai")
  livraison String @map("livraison")

  // SNAPSHOT
  nom       String? @map("nom")
  email     String? @map("email")
  telephone String? @map("telephone")
  ville     String? @map("ville")
  pays      String? @map("pays")
  source    String? @map("source")

  // 🔥 UPDATE
  status CustomOrderStatus @default(pending) @map("status")

  // 💬 CHAT
  conversations Conversation[]

  payments Payment[]

  finalPrice Float? @map("final_price")
  paidAmount Float @default(0) @map("paid_amount")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("custom_mode_orders")
}

enum CustomOrderStatus {
  pending
  in_progress
  completed
  cancelled
}

model Conversation {
  id String @id @default(uuid())

  orderId String
  order   CustomModeOrder @relation(fields: [orderId], references: [id])

  isOpen Boolean @default(true)

  messages Message[]

  createdAt DateTime @default(now())
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderType String // "admin" | "client"
  content String

  createdAt DateTime @default(now())
}

model BlacklistedToken {
  id        String   @id @default(uuid()) @map("id")
  token     String   @map("token")
  userId    String   @map("user_id")
  role      String   @map("role")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
}



model ContactMessage {
  id String @id @default(uuid()) @map("id")

  name  String  @map("name")
  email String  @map("email")
  phone String? @map("phone")

  subject ContactSubject @map("subject")
  message String         @map("message")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model Testimonial {
  id           String   @id @default(uuid()) @map("id")

  fullName     String   @map("full_name")
  occupation   String   @map("occupation")
  content      String   @db.Text @map("content")

  avatar       String   @map("avatar")
  type         String   @default("mode") @map("type")

  isPublished  Boolean  @default(true) @map("is_published")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isPublished])
  @@map("testimonials")
}

enum ProductCategory {
  pagne
  tissu
  accessoire
  pret_a_porter
  creation
}

enum PortfolioCategory {
  stylisme
  modelisme
  accessoire
}

enum BlogCategory {
  stylisme
  modelisme
  accessoire
  business
  tendance
}

enum ClientRole {
  client
  admin
}

enum ClientGender {
  femme
  homme
  autre
}

enum PaymentMethod {
  mobile_money
  card
  bank_transfer
}

enum ShippingZone {
  national
  international
}

enum Currency {
  FCFA
  EUR
}

enum ContactSubject {
  information
  commande
  collaboration
  support
}
